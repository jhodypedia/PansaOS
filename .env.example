NODE_ENV=production
PORT=3001
PUBLIC_URL=https://YOUR_DOMAIN
MASTER_KEY=GENERATE_64_HEX_CHARACTERS
DASH_TOKEN=GENERATE_LONG_RANDOM_TOKEN
BOT_TOKEN=
ADMIN_IDS=
DATA_DIR=/app/data
WORKSPACE_DIR=/app/workspace
HOST_WORKSPACE_DIR=/app/workspace
SKILLS_DIR=/app/skills
PLUGINS_DIR=/app/plugins
SOUL_PATH=/app/SOUL.md
ALLOW_UNSANDBOXED=false
SANDBOX_NETWORK=false
SANDBOX_IMAGE=pansaos-sandbox:local
MAX_STEPS=25
TASK_TIMEOUT_MS=900000
TOOL_OUTPUT_LIMIT=16000
MAX_CONCURRENCY=4
MAX_TASK_COST=5
SEARCH_URL=
SEARCH_KEY=
TELEGRAM_MODE=auto
WEBHOOK_SECRET=
ALLOW_PRIVATE_NETWORK=false
