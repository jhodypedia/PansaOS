FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
COPY apps/core/package.json apps/core/package.json
RUN npm install
COPY tsconfig.json ./tsconfig.json
COPY apps/core apps/core
RUN npm run build -w @pansa/core
FROM docker:29.1.3-cli AS docker-cli
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl unzip zip git python3 build-essential sqlite3 && rm -rf /var/lib/apt/lists/*
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/core/node_modules ./apps/core/node_modules
RUN /app/apps/core/node_modules/.bin/playwright install --with-deps chromium
COPY --from=build /app/apps/core/dist ./apps/core/dist
COPY --from=build /app/apps/core/package.json ./apps/core/package.json
COPY skills ./skills
COPY commands ./commands
COPY SOUL.md ./SOUL.md
RUN mkdir -p /app/data /app/workspace /app/plugins
EXPOSE 3001
CMD ["node","apps/core/dist/index.js"]
