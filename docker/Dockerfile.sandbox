FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends bash git python3 python3-pip python3-venv zip unzip ripgrep universal-ctags ca-certificates curl wget jq \
    libasound2 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 libcairo2 libcups2 libdbus-1-3 libdrm2 libgbm1 libgtk-3-0 libnspr4 libnss3 libpango-1.0-0 libx11-xcb1 libxcomposite1 libxdamage1 libxfixes3 libxkbcommon0 libxrandr2 libxshmfence1 fonts-liberation xdg-utils \
    && npm install --global @puppeteer/browsers \
    && npx --yes @puppeteer/browsers install chrome@stable --path /opt/chrome \
    && ln -s /opt/chrome/chrome/linux-*/chrome-linux64/chrome /usr/local/bin/chrome-for-testing \
    && rm -rf /var/lib/apt/lists/*
ENV HOME=/workspace/.home
ENV PATH=/workspace/.local/bin:/workspace/.tools:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
USER node
WORKDIR /workspace
CMD ["bash"]
