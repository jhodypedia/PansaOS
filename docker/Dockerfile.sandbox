FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends bash git python3 python3-pip python3-venv zip unzip ripgrep universal-ctags ca-certificates curl wget jq && rm -rf /var/lib/apt/lists/*
ENV HOME=/workspace/.home
ENV PATH=/workspace/.local/bin:/workspace/.tools:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
USER node
WORKDIR /workspace
CMD ["bash"]
